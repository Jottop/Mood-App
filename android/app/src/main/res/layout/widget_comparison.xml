<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_comparison_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- El fondo redondeado con degradado lo pinta ahora el propio bitmap de
         ComparisonWidgetPainter (degradado clásico o el color que elija el
         usuario); la escena ocupa el widget completo sin margen añadido. -->
    <ImageView
        android:id="@+id/comparison_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_placeholder"
        android:contentDescription="@string/widget_comparison_label" />
</FrameLayout>